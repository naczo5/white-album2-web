# Local secrets and pack staging (never commit)
.env
.env.*
!/.env.example
/.env
/wa2-web/.env
/wa2-web/.env.*
/wa2-web/pack/

# Agent harness metadata installed outside the project skills tree
.agents/
skills-lock.json

# Private hosting/release docs (kept locally, not tracked)
/wa2-web/docs/HOSTING.md
/wa2-web/docs/RELEASE.md

# --- User-supplied / machine-generated: never commit ---
# Original game + patch archives supplied by the user (BYOA)
/white-album-2-extended-edition-tokuten/
*.pak
*.LAC
*.iso
*.mds
*.rar
# Media extensions (game content arrives as these; nothing in-tree uses
# them as source — web audio/images are gitignored build outputs below)
/InstallerDiscs/
/GameDiscs/
/.cache/
# Upstream checkouts / downloaded releases (re-fetchable)
/upstream/
*.zip
*.pdf
*.ogg
*.mp3
*.mp4
*.png
*.wav
*.ogv

# --- Build outputs (regenerated by tools/build.py) ---
/wa2-web/web/public/data
/wa2-web/web/dist/
/wa2-web/assets/
/wa2-web/build/
/wa2-web/package/
/wa2-web/oneclick.json
*.log

# --- Runtime / editor noise ---
node_modules/
__pycache__/
*.pyc
.pytest_cache/
.coverage
.DS_Store
.vscode/
.idea/
/wa2-web/web/public/assets

# Ghidra (static analysis tooling, never commit)
ghidra_*.zip
ghidra_*/
